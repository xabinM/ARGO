# .env - 급속 버전 환경 설정

# ===== 🔑 API 키 (필수) =====
# SSAFY GMS API Configuration
GMS_API_KEY=S13P11A301-3348a7ad-a059-483f-8a0d-63e685eb8762
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

# OpenAI API (Backup option)
OPENAI_API_KEY=your_openai_api_key_here

# ===== ⚡ 급속 버전 설정 =====
# 서버 포트
RAPID_SERVER_PORT=8000

# 로그 레벨 (개발용)
LOG_LEVEL=INFO

# 데이터 파일 경로
RAPID_DATA_FILE=data/heritage_rapid_database.json

# ===== 🧪 개발 모드 설정 =====
# 개발 환경에서만 사용
DEBUG_MODE=true
RELOAD_SERVER=true

# ❌ 제외된 설정들 (기존에 있던 것)
# EMBEDDING_MODEL_NAME=          # 임베딩 안 씀
# FAISS_INDEX_PATH=              # FAISS 안 씀  
# CACHE_TTL_HOURS=               # 간단 캐시만
# BATCH_SIZE=                    # 배치 처리 안 씀
# MAX_WORKERS=                   # 단순 처리만
# POSTGRES_URL=                  # DB 없이 JSON만
# REDIS_URL=                     # 캐시 복잡하게 안 씀

# 📝 API 키 발급 방법
# 1. Tour API: https://data.go.kr → '한국관광공사_국문 관광정보 서비스' 신청
# 2. GMS API: SSAFY 제공 또는 OpenAI 직접 신청

# 🔧 설정 확인 방법
# python -c "from dotenv import load_dotenv; import os; load_dotenv(); print('Tour API:', '✅' if os.getenv('TOUR_API_KEY') else '❌'); print('LLM API:', '✅' if os.getenv('GMS_API_KEY') or os.getenv('OPENAI_API_KEY') else '❌')"